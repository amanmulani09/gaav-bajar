{
  "expo": {
    "name": "गाव बाजार",
    "slug": "gaav-bajar",
    "version": "1.0.0",
    "scheme": "gaavbajar",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "in.gaavbajar.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#214F37"
      },
      "allowBackup": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "जाहिरातीसाठी फोटो निवडा / विज्ञापन के लिए फोटो चुनें",
          "cameraPermission": "जाहिरातीसाठी फोटो काढा / विज्ञापन के लिए फोटो लें",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-image",
      "expo-secure-store",
      "./plugins/withReleaseSigningGuard.cjs"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
